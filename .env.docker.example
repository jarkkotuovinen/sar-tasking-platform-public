# Production Environment Variables for Docker
# Copy this file to .env.docker and update with production values

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-secure-password
POSTGRES_DB=iceye_tasking
DATABASE_URL=postgresql://postgres:change-this-secure-password@postgres:5432/iceye_tasking?schema=public

# JWT Authentication (MUST be the same across all services!)
JWT_SECRET=change-this-to-a-very-long-random-secret-key-for-production
JWT_EXPIRATION=7d

# Logging
LOG_LEVEL=info

# Optional: Override service ports (if needed)
# FRONTEND_PORT=80
# BACKEND_PORT=4000
# SATELLITE_PASS_PORT=8001
# AOI_VALIDATOR_PORT=8002
